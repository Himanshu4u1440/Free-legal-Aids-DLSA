# DLSA Portal Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dlsa_portal_secure_secret_key_2026

# Microsoft SQL Server Configuration
# Set DB_TYPE to 'mssql' to connect to Microsoft SQL Server
# If DB_TYPE is 'auto', it tries MS SQL Server first, and falls back to local SQLite if MS SQL Server is offline.
DB_TYPE=auto

# MS SQL Server Connection Details
DB_SERVER=localhost
DB_DATABASE=DLSA_DB
# For Windows Integrated Authentication, set DB_TRUSTED_CONNECTION=yes
DB_TRUSTED_CONNECTION=yes
# If using SQL Server Authentication (username & password), uncomment and fill:
# DB_USER=sa
# DB_PASSWORD=YourPasswordHere
# DB_TRUSTED_CONNECTION=no

# ODBC Driver for MS SQL Server: 'SQL Server' or 'ODBC Driver 17 for SQL Server' or 'ODBC Driver 18 for SQL Server'
DB_DRIVER=SQL Server

# SQLite Fallback / Local Database Path
SQLITE_DB_PATH=dlsa.db
